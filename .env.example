# Copy to .env and uncomment to use a real OpenAI-compatible model.
# Without LLM_API_KEY the demo uses the built-in scripted mock (no network, no cost).
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Postgres used by `db` (also read by docker compose for interpolation).
POSTGRES_USER=sideagent
POSTGRES_PASSWORD=sideagent
POSTGRES_DB=sideagent
POSTGRES_PORT=5433

# Host ports.
API_PORT=8787
WEB_PORT=8080

# Table for chunks; the schema is created on first write.
PG_VECTOR_TABLE=sideagent_chunks

# Browser origins allowed to call /agent (comma separated).
DEMO_ORIGINS=http://localhost:8080,http://localhost:8787,http://localhost:5173
