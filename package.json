{
  "name": "sideagent",
  "version": "0.12.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "workerd": "./dist/server/index.js",
      "worker": "./dist/server/index.js",
      "browser": "./dist/server/browser.js",
      "import": "./dist/server/index.js"
    },
    "./workers-ai": {
      "types": "./dist/workers-ai/index.d.ts",
      "workerd": "./dist/workers-ai/index.js",
      "worker": "./dist/workers-ai/index.js",
      "import": "./dist/workers-ai/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    },
    "./testing": {
      "types": "./dist/testing/mock-llm.d.ts",
      "import": "./dist/testing/mock-llm.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./admin/pg": {
      "types": "./dist/admin/pg.d.ts",
      "import": "./dist/admin/pg.js"
    },
    "./admin/auth": {
      "types": "./dist/admin/auth.d.ts",
      "import": "./dist/admin/auth.js"
    },
    "./admin/ui": {
      "types": "./dist/admin/ui.d.ts",
      "import": "./dist/admin/ui.js"
    },
    "./admin/contract": {
      "types": "./dist/admin/contract.d.ts",
      "import": "./dist/admin/contract.js"
    },
    "./admin/node": {
      "types": "./dist/admin/node.d.ts",
      "import": "./dist/admin/node.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!skills/**/evals"
  ],
  "scripts": {
    "build": "tsup && pnpm build:ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin-ui",
    "format": "prettier --write src dev admin-ui",
    "format:check": "prettier --check src dev admin-ui",
    "dev": "trap 'kill 0' EXIT; tsx watch dev/server.ts & vite -c admin-ui/vite.config.ts",
    "admin:start": "NODE_ENV=production tsx dev/server.ts",
    "eval:skill": "cd skills/sideagent && claude plugin eval . --scaffold --allow-tools Write Edit --trust-plugin --no-publish",
    "build:ui": "vite build -c admin-ui/vite.config.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/openai": "^1.7.0",
    "@langchain/textsplitters": "^1.0.2",
    "@radix-ui/react-icons": "^1.3.2",
    "htmlparser2": "^12.0.0",
    "langchain": "^1.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "better-auth": ">=1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": ">=4.6",
    "jose": "^6.2.15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "jose": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "0.0.12",
    "@hono/node-server": "^1.14.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "better-auth": "1.7.14",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.30.2"
}
