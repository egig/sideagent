{
  "name": "sideagent",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "workerd": "./dist/server/index.js",
      "worker": "./dist/server/index.js",
      "browser": "./dist/server/browser.js",
      "import": "./dist/server/index.js"
    },
    "./workers-ai": {
      "types": "./dist/workers-ai/index.d.ts",
      "workerd": "./dist/workers-ai/index.js",
      "worker": "./dist/workers-ai/index.js",
      "import": "./dist/workers-ai/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js"
    },
    "./testing": {
      "types": "./dist/testing/mock-llm.d.ts",
      "import": "./dist/testing/mock-llm.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!skills/**/evals"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src demo",
    "format:check": "prettier --check src demo",
    "demo:api": "tsx demo/server.ts",
    "demo": "tsx demo/server.ts & vite demo",
    "eval:skill": "cd skills/sideagent && claude plugin eval . --scaffold --allow-tools Write Edit --trust-plugin --no-publish"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.31",
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/openai": "^1.7.0",
    "@langchain/textsplitters": "^1.0.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@scalar/openapi-parser": "^0.29.16",
    "htmlparser2": "^12.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "hono": "^4.9.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.30.2"
}
